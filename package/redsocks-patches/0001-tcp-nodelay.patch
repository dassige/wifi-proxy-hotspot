+int apply_tcp_nodelay(int fd)
+{
+	// Disable Nagle's algorithm on relay sockets: without this, small
+	// handshake-sized writes (CONNECT line, TLS handshake fragments)
+	// sit waiting for either more data to coalesce or the peer's delayed
+	// ACK before they're actually sent, which is punishing on a
+	// high-latency link -- costing hundreds of ms per round trip on top
+	// of real network RTT.
+	int on = 1;
+	int error = setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on));
+	if (error) {
+		log_errno(LOG_WARNING, "setsockopt(%d, IPPROTO_TCP, TCP_NODELAY, &1, %zu)", fd, sizeof(on));
+		return -1;
+	}
+	return 0;
+}
